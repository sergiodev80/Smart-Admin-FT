DEBUG=True
SECRET_KEY=dev-secret-key-cambiar-en-produccion

# PostgreSQL (desarrollo — coincide con docker-compose.dev.yml)
DB_NAME=app_db_dev
DB_USER=django_user
DB_PASSWORD=django_pass
DB_HOST=db_dev
DB_PORT=5432

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Email (consola por defecto — no envía emails reales en dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

# Notifications — webhook signing secret (cualquier string aleatorio en prod)
WEBHOOK_SECRET=
